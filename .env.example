# Copy this file to .env and change the values.

# Database. Default is a local SQLite file (good for one shop, zero setup).
# For multiple branches / heavy use, switch to PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://luxe:strongpassword@localhost:5432/luxe
DATABASE_URL=sqlite:///./data/luxe.db

# REQUIRED: long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-this-to-a-long-random-string

# Login session length in hours
TOKEN_HOURS=12

# Printed on invoices, statements and factory orders
BUSINESS_NAME=Luxe Laminate
BUSINESS_ADDRESS=Shop No. 1, Main Road, Your City
BUSINESS_PHONE=+91 90000 00000
BUSINESS_GSTIN=

# Round GST on each bill line to whole rupees (1 = yes, 0 = keep paise)
GST_ROUND_RUPEE=1
# Terms printed at the bottom of every bill. Separate lines with |
BILL_TERMS=Goods once sold will not be accepted back.|Subject to Ahmedabad jurisdiction only. E.& O.E.
# Optional bank / UPI details printed on bills
BANK_DETAILS=

# Where backups are written
BACKUP_DIR=./backups
# How many automatic backups to keep
BACKUP_KEEP=30
